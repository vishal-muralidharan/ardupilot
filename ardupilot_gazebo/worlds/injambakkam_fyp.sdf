<?xml version="1.0" ?>
<!--
  Injambakkam, Chennai – FYP V4 Simulation World
  ================================================
  Location  : Injambakkam, Chennai, Tamil Nadu, India
  Lat / Lon : 12.9516° N, 80.2573° E
  Elevation : ~6 m MSL (coastal/flat terrain)

  UAV       : Iris quad-rotor with ArduPilot SITL plugin
  Control   : External EWMPC + Wind-EKF V6 bridge via MAVLink UDP

  Simulates a 1 km coastal delivery mission from Injambakkam beach
  to a waypoint ~1 km inland (roughly toward Sholinganallur).
-->
<sdf version="1.9">
  <world name="injambakkam_fyp">

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Physics                                                           -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Plugins                                                           -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat">
    </plugin>

    <!-- Wind plugin – coastal south-easterly (Bay of Bengal onshore) -->
    <plugin filename="gz-sim-wind-effects-system"
            name="gz::sim::systems::WindEffects">
      <!-- Mean wind: 4 m/s from SE (typical Chennai coastal) -->
      <horizontal_mean_vel>-2.83 2.83 0.0</horizontal_mean_vel>
      <!-- Turbulence amplitude: matches Scenario 2 (moderate turbulence) -->
      <horizontal_var_time>3.0</horizontal_var_time>
      <vertical_var_time>3.0</vertical_var_time>
      <horizontal_gust_vel_stddev>1.5</horizontal_gust_vel_stddev>
    </plugin>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Scene                                                              -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <scene>
      <ambient>0.9 0.88 0.82 1.0</ambient>
      <background>0.6 0.78 0.95 1.0</background>
      <sky>
        <clouds>
          <speed>5</speed>
          <direction>2.35619</direction>
          <humidity>0.8</humidity>
          <mean_size>0.5</mean_size>
          <ambient>0.9 0.9 0.9 1</ambient>
        </clouds>
        <time>12</time>
        <sunrise>6</sunrise>
        <sunset>19</sunset>
      </sky>
      <shadows>true</shadows>
      <fog>
        <color>0.8 0.85 0.9 1.0</color>
        <type>linear</type>
        <start>800</start>
        <end>2000</end>
        <density>0.005</density>
      </fog>
    </scene>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- GPS Origin – Injambakkam Beach (12.9516 N, 80.2573 E)            -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <spherical_coordinates>
      <latitude_deg>12.9516</latitude_deg>
      <longitude_deg>80.2573</longitude_deg>
      <elevation>6.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Sun / Directional Light                                           -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 1000 0 0 0</pose>
      <!-- South-east sun angle (mid-day Chennai) -->
      <direction>-0.4 0.35 -0.85</direction>
      <diffuse>1.0 0.97 0.9 1</diffuse>
      <specular>0.5 0.48 0.44 1</specular>
      <attenuation>
        <range>2000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Ground Plane                                                       -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <!-- Sandy coastal terrain colour -->
            <ambient>0.78 0.71 0.55 1</ambient>
            <diffuse>0.78 0.71 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Coordinate Axes Visualisation                                      -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <model name="origin_axes">
      <static>1</static>
      <link name="link">
        <!-- X axis – East – Red -->
        <visual name="x_axis">
          <cast_shadows>0</cast_shadows>
          <pose>10 0 0.05 0 0 0</pose>
          <geometry>
            <box><size>20 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <emissive>0.8 0 0 1</emissive>
          </material>
        </visual>
        <!-- Y axis – North – Green -->
        <visual name="y_axis">
          <cast_shadows>0</cast_shadows>
          <pose>0 10 0.05 0 0 0</pose>
          <geometry>
            <box><size>0.05 20 0.05</size></box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <emissive>0 0.8 0 1</emissive>
          </material>
        </visual>
        <!-- Z axis – Up – Blue -->
        <visual name="z_axis">
          <cast_shadows>0</cast_shadows>
          <pose>0 0 5.05 0 0 0</pose>
          <geometry>
            <box><size>0.05 0.05 10</size></box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <emissive>0 0 0.8 1</emissive>
          </material>
        </visual>
        <!-- NavSat sensor for telemetry feed to bridge -->
        <sensor name="navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
        </sensor>
      </link>
    </model>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Mission Waypoint Markers                                          -->
    <!-- Start  : (0, 0)      – Injambakkam beach launch pad              -->
    <!-- Goal   : (0, 1000)   – ~1 km North toward Sholinganallur         -->
    <!-- ───────────────────────────────────────────────────────────────── -->

    <!-- Launch Pad -->
    <model name="launch_pad">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="pad_base">
          <geometry>
            <cylinder><radius>2.5</radius><length>0.05</length></cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <emissive>0.05 0.05 0.05 1</emissive>
          </material>
        </visual>
        <visual name="pad_h_bar_x">
          <pose>0 0 0.06 0 0 0</pose>
          <geometry>
            <box><size>4.5 0.3 0.05</size></box>
          </geometry>
          <material>
            <ambient>1 0.9 0 1</ambient>
            <diffuse>1 0.9 0 1</diffuse>
            <emissive>0.5 0.45 0 1</emissive>
          </material>
        </visual>
        <visual name="pad_h_bar_y">
          <pose>0 0 0.06 0 0 1.5708</pose>
          <geometry>
            <box><size>4.5 0.3 0.05</size></box>
          </geometry>
          <material>
            <ambient>1 0.9 0 1</ambient>
            <diffuse>1 0.9 0 1</diffuse>
            <emissive>0.5 0.45 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Goal Marker (1 km north) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>0 1000 0.01 0 0 0</pose>
      <link name="link">
        <visual name="goal_disc">
          <geometry>
            <cylinder><radius>5.0</radius><length>0.1</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0.8 0.2 0.9</ambient>
            <diffuse>0 0.8 0.2 0.9</diffuse>
            <emissive>0 0.4 0.1 1</emissive>
          </material>
        </visual>
        <visual name="goal_pole">
          <pose>0 0 5 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.1</radius><length>10</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0.8 0.2 1</ambient>
            <diffuse>0 0.8 0.2 1</diffuse>
            <emissive>0 0.6 0.15 1</emissive>
          </material>
        </visual>
        <visual name="goal_flag">
          <pose>0.6 0 9.5 0 0 0</pose>
          <geometry>
            <box><size>1.2 0.05 0.8</size></box>
          </geometry>
          <material>
            <ambient>0 0.8 0.2 1</ambient>
            <diffuse>0 0.8 0.2 1</diffuse>
            <emissive>0 0.6 0.15 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Coastal Obstacle Set (representative buildings, ~50m grid)        -->
    <!-- ───────────────────────────────────────────────────────────────── -->

    <!-- Row of low coastal structures north-west of launch pad -->
    <model name="building_01">
      <static>true</static>
      <pose>80 150 0 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>25 20 8</size></box></geometry>
          <material><ambient>0.85 0.78 0.68 1</ambient><diffuse>0.85 0.78 0.68 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>25 20 8</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="building_02">
      <static>true</static>
      <pose>-60 220 0 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>18 22 12</size></box></geometry>
          <material><ambient>0.88 0.82 0.74 1</ambient><diffuse>0.88 0.82 0.74 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>18 22 12</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="building_03">
      <static>true</static>
      <pose>120 350 0 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>30 15 6</size></box></geometry>
          <material><ambient>0.80 0.76 0.65 1</ambient><diffuse>0.80 0.76 0.65 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>30 15 6</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="building_04">
      <static>true</static>
      <pose>-90 480 0 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>20 20 10</size></box></geometry>
          <material><ambient>0.82 0.79 0.71 1</ambient><diffuse>0.82 0.79 0.71 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>20 20 10</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="building_05">
      <static>true</static>
      <pose>50 620 0 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>22 18 14</size></box></geometry>
          <material><ambient>0.87 0.83 0.76 1</ambient><diffuse>0.87 0.83 0.76 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>22 18 14</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="building_06">
      <static>true</static>
      <pose>-30 780 0 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>15 25 9</size></box></geometry>
          <material><ambient>0.83 0.77 0.67 1</ambient><diffuse>0.83 0.77 0.67 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>15 25 9</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Water tower landmark near goal -->
    <model name="water_tower">
      <static>true</static>
      <pose>-150 900 0 0 0 0</pose>
      <link name="link">
        <visual name="vis_legs">
          <geometry><box><size>8 8 18</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
        <visual name="vis_tank">
          <pose>0 0 16 0 0 0</pose>
          <geometry><cylinder><radius>5</radius><length>8</length></cylinder></geometry>
          <material><ambient>0.6 0.65 0.7 1</ambient><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>8 8 18</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Trees (cylindrical + sphere approximate) along mission corridor   -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <model name="tree_row_01">
      <static>true</static>
      <pose>40 100 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4 0 0 0</pose>
          <geometry><sphere><radius>3.5</radius></sphere></geometry>
          <material><ambient>0.15 0.5 0.15 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_row_02">
      <static>true</static>
      <pose>-45 250 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <geometry><cylinder><radius>0.3</radius><length>6</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 5 0 0 0</pose>
          <geometry><sphere><radius>4.0</radius></sphere></geometry>
          <material><ambient>0.15 0.5 0.15 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_row_03">
      <static>true</static>
      <pose>65 500 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4 0 0 0</pose>
          <geometry><sphere><radius>3.5</radius></sphere></geometry>
          <material><ambient>0.15 0.5 0.15 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Road (visual only) – simulates ECR-style coastal road            -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <model name="ecr_road_segment">
      <static>true</static>
      <pose>100 500 0.005 0 0 0.45</pose>
      <link name="link">
        <visual name="road_vis">
          <geometry><box><size>15 1200 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Iris UAV (ArduPilot SITL bridge – port 9002/9003)                -->
    <!-- Spawned at origin with 0.195 m ground clearance                  -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <include>
      <uri>model://iris_with_ardupilot</uri>
      <!-- NED origin, slight yaw toward North -->
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>

  </world>
</sdf>
